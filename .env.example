# ReleaseGuard configuration — every value is optional. Copy to .env.local to override.
# NEXT_PUBLIC_* values are inlined at build time: rebuild after changing them.

# Name shown in the header.
# NEXT_PUBLIC_RG_APP_NAME=ReleaseGuard

# Fallback content language when the SitecoreAI host does not report one.
# NEXT_PUBLIC_RG_DEFAULT_LANGUAGE=en

# Starting path before a site is picked.
# NEXT_PUBLIC_RG_CONTENT_ROOT=/sitecore/content

# Default and maximum items one audit may crawl.
# NEXT_PUBLIC_RG_DEFAULT_MAX_ITEMS=300
# NEXT_PUBLIC_RG_MAX_ITEMS_LIMIT=2000

# Items per aliased GraphQL request, and requests in flight at once.
# NEXT_PUBLIC_RG_BATCH_SIZE=10
# NEXT_PUBLIC_RG_CONCURRENCY=4

# Marketplace SDK / Authoring GraphQL timeouts (ms).
# NEXT_PUBLIC_RG_SDK_TIMEOUT_MS=20000
# NEXT_PUBLIC_RG_GRAPHQL_TIMEOUT_MS=30000

# External link checks: max URLs per audit, and the server-side per-URL timeout (ms).
# NEXT_PUBLIC_RG_MAX_EXTERNAL_URLS=400
# RG_LINK_CHECK_TIMEOUT_MS=8000
